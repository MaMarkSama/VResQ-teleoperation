  m_text: "<b>SURVIVABILITY SCORE: <color=#00FF88>100%</color></b>\n\u2022 <b>\u0E01\u0E32\u0E23\u0E22\u0E36\u0E14\u0E40\u0E01\u0E32\u0E30/\u0E25\u0E49\u0E2D\u0E02\u0E31\u0E1A:</b>
    <color=#00FF88>TRACTION NOMINAL (\u0E2A\u0E20\u0E32\u0E1E\u0E1E\u0E37\u0E49\u0E19\u0E1C\u0E34\u0E27\u0E1B\u0E01\u0E15\u0E34)</color>\n\u2022
    <b>\u0E2A\u0E20\u0E32\u0E1E\u0E42\u0E1E\u0E23\u0E07\u0E2D\u0E32\u0E01\u0E32\u0E28:</b>
